{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nablamath.org/schema/nabla-model-v1.json",
  "title": "Nabla model lineage manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecture", "parent_ids", "dataset_ids", "training_code_id", "evaluation_ids", "license"],
  "properties": {
    "architecture": {"type": "string", "minLength": 1},
    "parent_ids": {"$ref": "nabla-object-v1.json#/$defs/ids"},
    "dataset_ids": {"$ref": "nabla-object-v1.json#/$defs/ids"},
    "training_code_id": {"$ref": "nabla-object-v1.json#/$defs/id"},
    "evaluation_ids": {"$ref": "nabla-object-v1.json#/$defs/ids"},
    "license": {"type": "string", "minLength": 1}
  }
}
